# Browser -> Next.js same-origin path. next.config.ts rewrites /api/v2/* to API_PROXY_TARGET,
# which sidesteps CORS (the ASP.NET API has no CORS policy). Set a full URL such as
# http://localhost:5131/api/v2 only after enabling CORS on the backend.
NEXT_PUBLIC_API_URL=/api/v2

# Server-side only: where the rewrite proxy forwards to.
API_PROXY_TARGET=http://localhost:5131

# Base domain for multi-tenant subdomains (nike.byvstore.com).
NEXT_PUBLIC_ROOT_DOMAIN=byvstore.com

# MinIO public media URL (only used to resolve relative image paths).
NEXT_PUBLIC_MEDIA_URL=http://localhost:9000
